{
    "name": "@vrl-shipment-network/sdk",
    "version": "0.2.0",
    "main": "./cjs/index.js",
    "types": "./cjs/index.d.ts",
    "osdk": {},
    "exports": {
        ".": {
            "script": {
                "types": "./dist/bundle/index.d.mts",
                "default": "./dist/bundle/index.mjs"
            },
            "require": {
                "types": "./cjs/index.d.ts",
                "default": "./cjs/index.js"
            },
            "import": {
                "types": "./esm/index.d.ts",
                "default": "./esm/index.js"
            },
            "types": "./cjs/index.d.ts",
            "default": "./cjs/index.js"
        },
        "./experimental/ontology-metadata": {
            "require": {
                "types": "./experimental/ontology-metadata.d.cts",
                "default": "./experimental/ontology-metadata.json"
            },
            "import": {
                "types": "./experimental/ontology-metadata.d.mts",
                "default": "./experimental/ontology-metadata.json"
            }
        }
    },
    "dependencies": {},
    "peerDependencies": {
        "@osdk/client": "^2.60.0"
    },
    "type": "commonjs"
}
